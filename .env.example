NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://findin:findin@localhost:5432/findin
# Signs login session cookies. Required in production (32+ random characters); optional locally.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=

# Stripe (Apple Pay / Google Pay / cards). Use test keys (sk_test_/pk_test_) in development.
# Secret key: backend only, never commit the real value.
STRIPE_SECRET_KEY=sk_test_replace_me
# Printed by `stripe listen --forward-to localhost:4000/api/payments/webhook`
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Publishable key: safe for the browser (Vite only exposes VITE_* variables).
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
