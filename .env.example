NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000
DATABASE_URL=postgresql://findin:findin@localhost:5432/findin
# Signs login session cookies. Required in production (32+ random characters); optional locally.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=

# OAuth (optional locally — use "Continue as demo student" without these).
# Callback URLs: {BACKEND_URL}/api/auth/google/callback and .../github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Frontend OAuth start redirects use this absolute API origin (defaults match local Vite+API).
VITE_API_BASE_URL=http://localhost:4000
