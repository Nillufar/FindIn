generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

/// Commitment / source visibility for a project card (FR-07, FR-03).
enum SourceType {
  OPEN_SOURCE
  PRIVATE_SOURCE
  PROPRIETARY
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum TimelineClass {
  SHORT
  MEDIUM
  LONG
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  displayName  String
  bio          String?
  skills       String[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  projects     Project[]
  applications Invitation[] @relation("Applicant")
  invitations  Invitation[] @relation("Inviter")
}

/// Project card (DR-01): core listing fields + required skill associations.
model Project {
  id             String                 @id @default(uuid())
  title          String
  description    String
  sourceType     SourceType
  repositoryUrl  String?
  fieldOfStudy   String
  minWeeklyHours Int
  timeline       TimelineClass
  status         ProjectStatus          @default(ACTIVE)
  ownerId        String
  owner          User                   @relation(fields: [ownerId], references: [id])
  requiredSkills ProjectRequiredSkill[]
  invitations    Invitation[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  lastActiveAt   DateTime               @default(now())

  @@index([ownerId])
  @@index([fieldOfStudy])
  @@index([sourceType])
  @@index([minWeeklyHours])
  @@index([status])
  /// Composite covering the most common FR-03 filter combination (NFR-03).
  @@index([status, fieldOfStudy, sourceType, minWeeklyHours])
}

/// Normalized skill tags for indexed multi-tag AND lookups (FR-03 / NFR-03).
model ProjectRequiredSkill {
  id        String  @id @default(uuid())
  projectId String
  skill     String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, skill])
  @@index([skill])
  @@index([skill, projectId])
}

model Invitation {
  id          String           @id @default(uuid())
  projectId   String
  applicantId String
  inviterId   String
  status      InvitationStatus @default(PENDING)
  message     String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  project     Project          @relation(fields: [projectId], references: [id])
  applicant   User             @relation("Applicant", fields: [applicantId], references: [id])
  inviter     User             @relation("Inviter", fields: [inviterId], references: [id])

  @@unique([projectId, applicantId])
  @@index([status])
}
